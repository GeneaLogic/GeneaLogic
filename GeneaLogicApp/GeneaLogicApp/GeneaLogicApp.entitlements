<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox + user-selected read/write were previously generated from the
	     ENABLE_APP_SANDBOX / ENABLE_USER_SELECTED_FILES build settings; they're
	     restated here because adding the app-scope bookmarks entitlement (which has
	     no build-setting toggle) requires an explicit entitlements file. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Persistent, app-scoped security-scoped bookmarks: lets the app re-acquire
	     access to a user-chosen .genea across relaunch (window restoration + Open
	     Recent), since a restored URL window-value carries no live sandbox scope. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
